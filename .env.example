# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Source: Databricks SQL warehouse (the free edition works)
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
NIRVANA_SOURCE_LOCATION=samples.tpcds_sf1

# Target: Zetaris Lightning (local install or AWS cluster)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=
ZETARIS_ORG_ID=1
NIRVANA_TARGET_LOCATION=TPCDS_DB

# Model: Meterless runtime (auto-detected on 8088/8090/8787/11434 when left empty)
METERLESS_URL=
METERLESS_TOKEN=
METERLESS_MODEL=meterless/auto

# Optional
# NIRVANA_HOME=./var
# NIRVANA_MODE=live          # or recorded
# NIRVANA_MAX_ROWS=100000
# NIRVANA_CORS=*

# Or NVIDIA hosted Nemotron (build.nvidia.com), used when METERLESS_URL is empty
NVIDIA_API_KEY=
